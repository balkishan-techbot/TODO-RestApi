<?xml version="1.0" encoding="utf-8"?><!-- Checkbox for Task Status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:orientation="vertical">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="2dp">

        <CheckBox
            android:id="@+id/taskStatus"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical" />

        <!-- Image for Task -->
        <ImageView
            android:id="@+id/taskImg"
            android:backgroundTint="#6A211F1F"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="3dp"
            android:contentDescription="@string/image_upload" />

        <!-- Container for Task Information (Status, Title, Description, Time) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <!-- Checkbox for Task Status and Task Title in one line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/taskId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="4dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Task Description -->
            <TextView
                android:id="@+id/taskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="14sp" />

            <!-- Task Time -->
            <TextView
                android:id="@+id/taskTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Action Button -->
    </LinearLayout>

    <Button
        android:id="@+id/actionButton"
        android:layout_width="250dp"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:backgroundTint="#0D47A1"
        android:text="@string/action_button"
        android:textColor="@color/white" />

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

</LinearLayout>